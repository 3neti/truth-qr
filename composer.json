{
    "name": "3neti/truth-qr",
    "description": "Offline-verifiable QR records with versioned domain profiles",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-sodium": "*",
        "bacon/bacon-qr-code": "^3.1",
        "symfony/process": "^8.0",
        "symfony/yaml": "^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "LBHurtado\\TruthQr\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LBHurtado\\TruthQr\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LBHurtado\\TruthQr\\Laravel\\TruthQrServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
